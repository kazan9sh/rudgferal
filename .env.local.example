# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_secure_random_string_here

# GitHub OAuth Application (create one at https://github.com/settings/developers)
GITHUB_ID=your_github_client_id
GITHUB_SECRET=your_github_client_secret

# Repository information
GITHUB_REPO_OWNER=dreamgrove
GITHUB_REPO_NAME=dreamgrove
GITHUB_BRANCH=next-15 

# Warcraft Logs API Configuration
# Create a client at https://www.warcraftlogs.com/api/clients/
WARCRAFT_LOGS_CLIENT_ID= wclogs_id
WARCRAFT_LOGS_CLIENT_SECRET= wclogs_key

# Discord-бот (bot/discord)
# Токен: Developer Portal → Bot → Reset Token. НЕ client secret со вкладки OAuth2.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_ADMIN_ROLE_ID=

# Источник гайда для сверки
GUIDE_UPSTREAM_REPO=dreamgrove/dreamgrove
GUIDE_UPSTREAM_BRANCH=master
GITHUB_TOKEN=
